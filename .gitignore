__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks: the committed .ipynb files are stripped of output, so a rerun does
# not produce a diff of base64 images.
.ipynb_checkpoints/

