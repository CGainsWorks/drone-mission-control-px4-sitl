# Generated results. Everything under results/ is reproducible from
# `python analysis/run_comparison.py`, so none of it belongs in git. The
# committed outputs are docs/RESULTS.md, docs/FAILSAFE_MATRIX.md,
# analysis/figures/ and config/tuned_gains.yaml.
results/

# Flight logs, in either format. Pointers live in docs/, the logs do not.
*.ulg
*.ulog

